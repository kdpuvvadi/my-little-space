{
  "manifest_version": 3,
  "name": "My Little Space",
  "version": "1.0.0",
  "description": "A calm, customizable new tab with search bangs and shortcuts.",
  "chrome_url_overrides": {
    "newtab": "src/newtab/index.html"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://catfact.ninja/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "My Little Space",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
